{
  "name": "1a2n-track-id",
  "version": "0.4.5",
  "private": true,
  "description": "Local Traktor Pro 4 deck/track overlay server for OBS (Twitch DJ streams)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts --no-auto-exit --dev",
    "start": "npm run build && node dist/main.js",
    "build": "tsc -p tsconfig.json && node scripts/build-overlay.mjs",
    "simulate": "tsx scripts/simulate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fontsource/cousine": "5.2.7",
    "@fontsource/libre-franklin": "5.2.8",
    "fastify": "5.10.0",
    "music-metadata": "11.14.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.1",
    "eslint": "10.7.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
